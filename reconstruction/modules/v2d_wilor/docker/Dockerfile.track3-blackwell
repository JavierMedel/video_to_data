# Reuse this laptop's compiled sm_120 geometry stack. No Track 1 image changes.
ARG BASE_IMAGE=v2d_cari4d:blackwell
FROM ${BASE_IMAGE}
WORKDIR /app
ARG WILOR_COMMIT=ebec42f94c389070cdd7dda6fd1bf0b4a659c960
ARG MANOTORCH_COMMIT=a2a70c591f91551078b7bb2af9b5d9f275b626e0
ARG CHUMPY_COMMIT=580566eafc9ac68b2614b64d6f7aaa84eebb70da
ARG HAMER_COMMIT=3a01849f4148352e9260b69bf28b65d1671a4905

# WiLoR's metadata caps torch at 2.5, which predates Blackwell support. Install
# its code without dependencies and retain the base's torch 2.8/cu128 pins.
RUN pip install --no-cache-dir "ultralytics==8.1.34" "transformers>=4.37,<5" \
    safetensors braceexpand av joblib loguru webdataset && \
    pip install --no-cache-dir --no-deps \
      "git+https://github.com/mattloper/chumpy.git@${CHUMPY_COMMIT}" \
      "git+https://github.com/lixiny/manotorch.git@${MANOTORCH_COMMIT}" \
      "git+https://github.com/warmshao/WiLoR-mini.git@${WILOR_COMMIT}"
RUN git clone https://github.com/geopavlakos/hamer.git /opt/hamer && \
    cd /opt/hamer && git checkout ${HAMER_COMMIT} && pip install --no-deps -e .

COPY modules/v2d_wilor/lib /workspace/v2d_wilor/lib
COPY modules/v2d_hamer/lib /workspace/v2d_hamer/lib
RUN pip install --no-deps -e /workspace/v2d_wilor/lib -e /workspace/v2d_hamer/lib
ENV PYOPENGL_PLATFORM=egl
# Upstream YOLO/HaMeR publisher checkpoints include serialized model objects.
# Keep this compatibility override scoped to the dedicated hand-model image.
ENV TORCH_FORCE_NO_WEIGHTS_ONLY_LOAD=1
RUN python -c "import torch; assert torch.__version__.startswith('2.8.0'); from wilor_mini.pipelines.wilor_hand_pose3d_estimation_pipeline import WiLorHandPose3dEstimationPipeline; from hamer.models import load_hamer; from manotorch.manolayer import ManoLayer; print('Track3 Blackwell hand imports OK')"
